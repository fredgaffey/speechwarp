<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- From Android 11 an app sees only the services it declares: this lets AndroidSentenceVoice find the
         installed text-to-speech engines. It merges into the app's manifest. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
