<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Apple's voices, Eloquence among them, exist only on Apple systems. -->
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackageId>Speechwarp.Voice</PackageId>
    <!-- Keep in step with SPEECHWARP_VERSION in include/speechwarp.h (tools/bump-version.sh does). -->
    <Version>0.3.7</Version>
    <Authors>The speechwarp contributors</Authors>
    <Description>Text read aloud by Apple's voices (Eloquence and the rest) or any other text-to-speech engine and sped up by speechwarp, spoken ahead of playback with the voice changeable between sentences and slow voices kept on disk, and speech recognised on the device by Apple's recogniser through the Speechwarp.Transcription interface, with a microphone source, for iOS. Not an official Apple or Google product.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fredgaffey/speechwarp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fredgaffey/speechwarp</RepositoryUrl>
    <PackageTags>speech;tts;text-to-speech;speech-to-text;transcription;eloquence;audiobook;ios;speed</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Speechwarp\Speechwarp.csproj" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\..\LICENSE;..\..\..\NOTICE" Pack="true" PackagePath="licenses" />
  </ItemGroup>

</Project>
