{
  "name": "react-native-speechwarp-voice-kokoro",
  "version": "0.3.7",
  "description": "Kokoro-82M, a neural voice on ONNX Runtime's CPU, for react-native-speechwarp-voice, with the catalogue of its model files",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-speechwarp-voice-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "scripts",
    "*.podspec",
    "LICENSE",
    "NOTICE",
    "!ios/build",
    "!android/build",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "vendor": "sh scripts/vendor.sh",
    "prepare": "sh scripts/vendor.sh && bob build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "text-to-speech",
    "tts",
    "kokoro",
    "onnx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredgaffey/speechwarp.git",
    "directory": "bindings/react-native-voice/kokoro"
  },
  "author": "The speechwarp contributors <noreply@github.com> (https://github.com/fredgaffey)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/fredgaffey/speechwarp/issues"
  },
  "homepage": "https://github.com/fredgaffey/speechwarp/blob/main/docs/voices.md#react-native",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "react-native-builder-bob": "^0.43.1",
    "react-native-speechwarp-voice": "workspace:*"
  },
  "peerDependencies": {
    "react-native": "*",
    "react-native-speechwarp-voice": "0.3.7"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "SpeechwarpVoiceKokoroSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "io.github.fredgaffey.speechwarp.reactnative.voice.kokoro"
    },
    "ios": {
      "modulesProvider": {
        "SpeechwarpVoiceKokoro": "RNSpeechwarpVoiceKokoro"
      }
    }
  }
}
